############
# Required #
############

GITHUB_WEBHOOK_SECRET=""
NOTION_TOKEN=""
NOTION_DATABASE_ID=""
NOTION_TASK_ID_PROPERTY="Task ID"
NOTION_TASK_ID_PREFIX="GEN"
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://localhost:4318/v1/traces"
NOTION_DRY_RUN=true
DD_API_KEY=""

# Optional: constrain which previous statuses are allowed before the webhook can
# set a new status (helps prevent overwriting manual statuses like "QA ready")
#
# Example:
# NOTION_STATUS_TRANSITION_RULES='{"In review":["In progress","In review"],"In progress":["In progress","In review"],"PR merged":"*"}'
NOTION_STATUS_TRANSITION_RULES=""

############
# Optional #
############
(with defaults): NODE_ENV (development)
API_VERSION=0.0.0
NODE_ENV=development
